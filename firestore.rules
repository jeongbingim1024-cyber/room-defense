rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 순위표: 누구나 읽기 가능, 새 기록 추가만 가능 (수정·삭제 불가)
    match /scores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'wave', 'kills', 'ts', 'ver'])
        && request.resource.data.keys().hasOnly(['name', 'wave', 'kills', 'ts', 'ver'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.wave is int
        && request.resource.data.wave >= 1 && request.resource.data.wave <= 200
        && request.resource.data.kills is int
        && request.resource.data.kills >= 0 && request.resource.data.kills <= 20000
        && request.resource.data.kills <= request.resource.data.wave * 200
        && request.resource.data.ts is timestamp
        && request.resource.data.ts > request.time - duration.value(10, 'm')
        && request.resource.data.ts < request.time + duration.value(10, 'm')
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 10;
      allow update, delete: if false;
    }
    // 그 밖의 모든 데이터는 접근 금지
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
