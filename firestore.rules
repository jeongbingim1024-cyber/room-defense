rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validScore(d) {
      return d.keys().hasAll(['name', 'wave', 'kills', 'ts', 'ver'])
        && d.keys().hasOnly(['name', 'wave', 'kills', 'ts', 'ver'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.wave is int && d.wave >= 1 && d.wave <= 200
        && d.kills is int && d.kills >= 0 && d.kills <= 20000 && d.kills <= d.wave * 200
        && d.ts is timestamp
        && d.ts > request.time - duration.value(10, 'm')
        && d.ts < request.time + duration.value(10, 'm')
        && d.ver is string && d.ver.size() <= 10;
    }
    // 순위표: 문서 이름 = 익명 로그인 uid. 한 사람(브라우저)당 한 줄, 자기 줄만, 더 좋은 기록일 때만 갱신
    match /ranking/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && validScore(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid && validScore(request.resource.data)
        && (request.resource.data.wave > resource.data.wave
            || (request.resource.data.wave == resource.data.wave && request.resource.data.kills > resource.data.kills));
      allow delete: if false;
    }
    // 클라우드 저장: 구글 로그인 uid별 문서 하나, 본인만 읽고 쓰기
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['code', 'ts', 'ver'])
        && request.resource.data.code is string && request.resource.data.code.size() <= 200000
        && request.resource.data.ts is timestamp
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 10;
    }
    // 그 밖의 모든 데이터는 접근 금지 (예전 scores 순위표 포함)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
