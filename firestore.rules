rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 = 게임 만든 사람의 구글 계정 (쿠폰 만들기, 테스트 순위 기록 지우기)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'sl476vY2bEWFky1yBVmvrTk2WIz2'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validScore(d) {
      return d.keys().hasAll(['name', 'wave', 'kills', 'ts', 'ver'])
        && d.keys().hasOnly(['name', 'wave', 'kills', 'ts', 'ver'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
        && d.wave is int && d.wave >= 1 && d.wave <= 200
        && d.kills is int && d.kills >= 0 && d.kills <= 20000 && d.kills <= d.wave * 200
        && d.ts is timestamp
        && d.ts > request.time - duration.value(10, 'm')
        && d.ts < request.time + duration.value(10, 'm')
        && d.ver is string && d.ver.size() <= 10;
    }
    // 순위표: 문서 이름 = 익명 로그인 uid. 한 사람(브라우저)당 한 줄, 자기 줄만, 더 좋은 기록일 때만 갱신
    match /ranking/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid && validScore(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid && validScore(request.resource.data)
        && (request.resource.data.wave > resource.data.wave
            || (request.resource.data.wave == resource.data.wave && request.resource.data.kills > resource.data.kills));
      allow delete: if isAdmin();
    }
    // 클라우드 저장: 구글 로그인 uid별 문서 하나, 본인만 읽고 쓰기
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.keys().hasOnly(['code', 'ts', 'ver'])
        && request.resource.data.code is string && request.resource.data.code.size() <= 200000
        && request.resource.data.ts is timestamp
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 10;
    }
    // 쿠폰: 코드를 아는 사람은 한 개씩 읽기만, 목록·만들기·끄기는 관리자만
    match /coupons/{code} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['bat', 'crate', 'on', 'ts'])
        && request.resource.data.bat is int && request.resource.data.bat >= 0 && request.resource.data.bat <= 100000
        && request.resource.data.crate is int && request.resource.data.crate >= 0 && request.resource.data.crate <= 1000
        && request.resource.data.on is bool;
    }
    // 공지: 누구나 읽기, 관리자만 쓰기
    match /notice/{id} {
      allow get: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['on', 'id', 'body', 'code', 'ts'])
        && request.resource.data.on is bool
        && request.resource.data.body is string && request.resource.data.body.size() <= 500
        && request.resource.data.code is string && request.resource.data.code.size() <= 20;
    }
    // 그 밖의 모든 데이터는 접근 금지 (예전 scores 순위표 포함)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
